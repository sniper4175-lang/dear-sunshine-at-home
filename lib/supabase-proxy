import {
    createServerClient
} from '@supabase/ssr';

import {
    NextResponse
} from 'next/server';


export async function updateSession(
    request
) {

    let supabaseResponse =
        NextResponse.next({
            request
        });


    const supabase =
        createServerClient(
            process.env
                .NEXT_PUBLIC_SUPABASE_URL,

            process.env
                .NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,

            {
                cookies: {

                    getAll() {

                        return request
                            .cookies
                            .getAll();

                    },


                    setAll(
                        cookiesToSet
                    ) {

                        /*
                         * Server Component가 읽는
                         * request cookie도 갱신
                         */
                        cookiesToSet.forEach(
                            ({
                                name,
                                value
                            }) => {

                                request.cookies.set(
                                    name,
                                    value
                                );

                            }
                        );


                        /*
                         * 갱신된 request를 이용해
                         * response 다시 생성
                         */
                        supabaseResponse =
                            NextResponse.next({
                                request
                            });


                        /*
                         * 브라우저에도
                         * 갱신된 쿠키 전달
                         */
                        cookiesToSet.forEach(
                            ({
                                name,
                                value,
                                options
                            }) => {

                                supabaseResponse
                                    .cookies
                                    .set(
                                        name,
                                        value,
                                        options
                                    );

                            }
                        );

                    }

                }
            }
        );


    /*
     * 중요:
     * 세션 토큰 검증 및 필요 시 갱신
     *
     * getClaims()는 새 Supabase 프로젝트의 비대칭 JWT에서
     * 서명을 로컬/캐시된 JWKS로 검증할 수 있어 getUser()처럼
     * 매 요청마다 Auth 서버 왕복을 만들지 않습니다.
     * 세션 만료가 가까우면 필요한 refresh도 처리합니다.
     */
    await supabase
        .auth
        .getClaims();


    return supabaseResponse;
}